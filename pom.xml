<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>ms.rohde</groupId>
    <artifactId>business-calendar-relay</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>business-calendar-relay</name>
    <description>Spiegelt private CalDAV-Kalender als titellose Blocker-Termine per iMIP in einen dienstlichen Outlook-Kalender</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <jspecify.version>1.0.0</jspecify.version>
        <archunit.version>1.4.0</archunit.version>
        <hexagonal-arch.version>1.0.0-SNAPSHOT</hexagonal-arch.version>
        <ical4j.version>4.1.1</ical4j.version>
    </properties>

    <dependencies>
        <!-- Spring Boot core (scheduling, configuration properties) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Bean validation for @ConfigurationProperties (source calendar config) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- SMTP transport for iMIP mail (BlockerSink adapter) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Spring Data JPA (StateStore persistence adapter) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Embedded file-mode H2 database backing the StateStore JPA adapter -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <!-- Actuator: /health -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Embedded servlet container (Tomcat) so Actuator can actually expose
             /actuator/health over HTTP on port 8080; without this, spring-boot-starter-actuator
             alone never binds a port, and the Dockerfile HEALTHCHECK/docker-compose.yml port
             mapping have nothing to reach. No REST controllers exist or are planned; this app
             stays otherwise headless. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Log4j2 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <!-- JSpecify -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
        </dependency>

        <!-- Jakarta Inject (JSR-330) -->
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>

        <!-- Hexagonal Architecture Annotations -->
        <dependency>
            <groupId>ms.rohde</groupId>
            <artifactId>hexagonal-arch-annotations</artifactId>
            <version>${hexagonal-arch.version}</version>
        </dependency>

        <!-- Hexagonal Architecture Spring Integration -->
        <dependency>
            <groupId>ms.rohde</groupId>
            <artifactId>hexagonal-arch-spring</artifactId>
            <version>${hexagonal-arch.version}</version>
        </dependency>

        <!-- ical4j: parses per-resource calendar-data ICS blobs read from CalDAV (CalendarSource adapter) -->
        <dependency>
            <groupId>org.mnode.ical4j</groupId>
            <artifactId>ical4j</artifactId>
            <version>${ical4j.version}</version>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>ms.rohde</groupId>
            <artifactId>hexagonal-arch-archunit</artifactId>
            <version>${hexagonal-arch.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- @DataJpaTest / TestEntityManager, split out into its own starter as of Spring Boot 4 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- ms.rohde:hexagonal-arch-* is a SNAPSHOT only published to this internal repository,
         never to Maven Central; required for both local builds and the containerized Docker
         build (see Dockerfile), neither of which has access to a developer's local .m2 cache. -->
    <repositories>
        <repository>
            <id>internal-snapshots</id>
            <url>http://maven.home/snapshots</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- module-info.java documents dependencies/nullability only, per its own
                         Javadoc note: the packaged app always runs on the plain classpath via
                         "java -jar", never on the module path. Surefire's default of putting a
                         module-info-bearing project's test classes on the module path would
                         contradict that: it can pull otherwise-unrelated dependencies (e.g.
                         hibernate-validator) onto the module path as real named modules, where
                         JPMS strong encapsulation then rejects reflective access Spring/
                         Hibernate rely on (e.g. hibernate-validator's
                         ResourceBundleMessageInterpolator against jakarta.el). Forcing the
                         classpath keeps test execution consistent with production. -->
                    <useModulePath>false</useModulePath>
                    <argLine>
                        -XX:+EnableDynamicAgentLoading
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.util=ALL-UNNAMED
                        --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
