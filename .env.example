# SMTP relay used to send iMIP invitations (BlockerSink)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=relay@example.com
SMTP_PASSWORD=changeme-use-a-strong-password

# Directory holding the embedded, file-mode H2 database backing StateStore.
# Must be writable by the process and survive restarts (mount a volume in Docker).
STATE_STORE_DATA_DIR=./data

# How often every configured source calendar is polled (Spring Duration syntax, e.g.
# 5m, 300s). Optional -- defaults to 5m if unset.
RELAY_POLL_INTERVAL=5m

# One source calendar's CalDAV credentials and relay identity, referenced from
# relay.calendars in the deployment's config file (see application.yml and README.md).
# This block covers exactly one calendar ("personal"); add one differently-named block
# per additional configured calendar (e.g. CALDAV_WORK_USERNAME, RELAY_WORK_..., and a
# matching relay.calendars entry) -- there is no fixed limit on how many calendars a
# deployment can configure.
CALDAV_PERSONAL_USERNAME=caldav-user
CALDAV_PERSONAL_PASSWORD=changeme-use-a-strong-password
RELAY_PERSONAL_ORGANIZER_EMAIL=organizer@example.com
RELAY_PERSONAL_ATTENDEE_EMAIL=business@example.com
RELAY_PERSONAL_FROM_ADDRESS=relay@example.com
RELAY_PERSONAL_REPLY_TO_ADDRESS=organizer@example.com
