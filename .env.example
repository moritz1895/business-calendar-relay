# SMTP relay used to send iMIP invitations (BlockerSink). Uses implicit TLS ("SMTP +
# SSL/TLS", not STARTTLS) -- port 465 is the standard for that. If your relay only
# offers STARTTLS on 587 instead, override SMTP_PORT to 587 and see application.yml's
# spring.mail.properties.mail.smtp.ssl.enable comment for how to switch modes.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=relay@example.com
SMTP_PASSWORD=changeme-use-a-strong-password

# Directory holding the embedded, file-mode H2 database backing StateStore.
# Must be writable by the process and survive restarts (mount a volume in Docker).
STATE_STORE_DATA_DIR=./data

# How often every configured source calendar is polled (Spring Duration syntax, e.g.
# 5m, 300s). Optional -- defaults to 5m if unset.
RELAY_POLL_INTERVAL=5m

# How far into the future a recurring source event's occurrence may start and still
# be eligible for its first blocker creation -- shared across every configured
# calendar, like RELAY_POLL_INTERVAL above, not a per-calendar setting. Single
# (non-recurring) events are not affected. ISO-8601 Period syntax, e.g. P6M, P90D.
# Optional -- defaults to P6M if unset.
RELAY_RECURRING_EVENT_HORIZON=P6M

# How many first-time blocker creations may be sent per RELAY_INITIALIZATION_BURST_INTERVAL
# while a source calendar is being initialized for the first time (anti-spam protection
# for the business mailbox) -- mailbox-wide across all configured calendars combined,
# not a per-calendar setting. Only affects one-time initialization, never steady-state
# operation. Optional -- defaults to 5 if unset.
RELAY_INITIALIZATION_BURST_SIZE=5

# Window size of the send budget from RELAY_INITIALIZATION_BURST_SIZE (Spring Duration
# syntax, e.g. PT1H, 30m) -- also mailbox-wide and global. Optional -- defaults to PT1H
# if unset.
RELAY_INITIALIZATION_BURST_INTERVAL=PT1H

# Uniform iMIP identity -- applies to every configured calendar, regardless of its type
# (relay.organizer-email/attendee-email/from-address/reply-to-address). Deliberately no
# per-calendar override any more (see docs/features/relay-config-consolidation.md) -- a
# single set, required, no default.
RELAY_ORGANIZER_EMAIL=organizer@example.com
RELAY_ATTENDEE_EMAIL=business@example.com
RELAY_FROM_ADDRESS=relay@example.com
RELAY_REPLY_TO_ADDRESS=organizer@example.com

# One CalDAV calendar's credentials, referenced from relay.calendars in the deployment's
# config file (see application.yml and README.md). This block covers exactly one
# calendar ("personal"); add one differently-named block per additional CalDAV calendar
# (e.g. CALDAV_WORK_USERNAME and a matching relay.calendars entry) -- there is no fixed
# limit on how many calendars a deployment can configure.
CALDAV_PERSONAL_USERNAME=caldav-user
CALDAV_PERSONAL_PASSWORD=changeme-use-a-strong-password
CALDAV_WORK_USERNAME=caldav-work-user
CALDAV_WORK_PASSWORD=changeme-use-a-strong-password

# One Google OAuth credential set, shared by any number of type: google calendar entries
# for the same Google account (relay.google-credentials[], see
# docs/features/relay-config-consolidation.md) -- previously one full set per calendar
# entry, now one set per Google account. google-client-id/-secret come from a Google
# Cloud project you create yourself; google-refresh-token is obtained once via the OAuth
# Playground consent flow described in docs/technical/google-calendar-setup.md -- never a
# real value here.
GOOGLE_PERSONAL_CLIENT_ID=changeme-oauth-client-id
GOOGLE_PERSONAL_CLIENT_SECRET=changeme-oauth-client-secret
GOOGLE_PERSONAL_REFRESH_TOKEN=changeme-refresh-token

# Two calendar ids of the same Google account above -- stays per calendar entry,
# unchanged by relay-config-consolidation.
GOOGLE_PERSONAL_CALENDAR_ID=you@gmail.com
GOOGLE_SECONDARY_CALENDAR_ID=team-events@group.calendar.google.com
